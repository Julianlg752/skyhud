SpeedOut = TextPlus {
	Inputs = {
		UseFrameFormatSettings = Input { Value = 1, },
		Wrap = Input { Value = 1, },
		LayoutRotation = Input { Value = 1, },
		TransformRotation = Input { Value = 1, },
		Size = Input { Value = 0.035, },
		Font = Input { Value = "{{font}}", },
		Style = Input { Value = "Bold", },
		Red1 = Input { Value = {{main.r}}, },
		Green1 = Input { Value = {{main.g}}, },
		Blue1 = Input { Value = {{main.b}}, },
		StyledText = Input { Expression = "Text(HUDData.NumberIn2 > 0.5 and string.format(\"SPEED\\n%.0f km/h\", HUDData.NumberIn1) or \"SPEED\\n-- km/h\")", },
		Enabled2 = Input { Value = 1, },
		Red2 = Input { Value = {{outline.r}}, },
		Green2 = Input { Value = {{outline.g}}, },
		Blue2 = Input { Value = {{outline.b}}, },
		Thickness2 = Input { Value = 0.04, },
		OutsideOnly2 = Input { Value = 1, },
		Softness2 = Input { Value = 1, },
		Enabled3 = Input { Value = 1, },
		VerticalJustificationNew = Input { Value = 3, },
		HorizontalJustificationNew = Input { Value = 3, },
	},
},
