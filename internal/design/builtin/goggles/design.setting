PathBoxMask = RectangleMask {
	Inputs = {
		UseFrameFormatSettings = Input { Value = 1, },
		Width = Input { Value = 0.17, },
		Height = Input { Expression = "0.17 * {{aspect}}", },
		CornerRadius = Input { Value = 0.08, },
	},
},
PathBox = Background {
	Inputs = {
		UseFrameFormatSettings = Input { Value = 1, },
		TopLeftRed = Input { Value = 0, },
		TopLeftGreen = Input { Value = 0, },
		TopLeftBlue = Input { Value = 0, },
		TopLeftAlpha = Input { Value = 0.25, },
		EffectMask = Input { SourceOp = "PathBoxMask", Source = "Mask", },
	},
},
PathLine = PolylineMask {
	DrawMode = "ClickAppend",
	Inputs = {
		UseFrameFormatSettings = Input { Value = 1, },
		Solid = Input { Value = 0, },
		BorderWidth = Input { Value = 0.0025, },
		Size = Input { Value = 0.14, },
		Polyline = Input { Value = Polyline { Points = { {{path}} }, }, },
	},
},
PathFaint = Background {
	Inputs = {
		UseFrameFormatSettings = Input { Value = 1, },
		TopLeftRed = Input { Value = {{main.r}}, },
		TopLeftGreen = Input { Value = {{main.g}}, },
		TopLeftBlue = Input { Value = {{main.b}}, },
		TopLeftAlpha = Input { Value = 0.35, },
		EffectMask = Input { SourceOp = "PathLine", Source = "Mask", },
	},
},
PathTrail = PolylineMask {
	DrawMode = "ClickAppend",
	Inputs = {
		UseFrameFormatSettings = Input { Value = 1, },
		Solid = Input { Value = 0, },
		Size = Input { Value = 0.14, },
		Polyline = Input { Value = Polyline { Points = { {{path}} }, }, },
		BorderWidth = Input { Value = 0.005, },
		WritePosition = Input { Expression = "math.max(0, HUDData3.NumberIn5 - 0.06)", },
		WriteLength = Input { Expression = "HUDData3.NumberIn5 - math.max(0, HUDData3.NumberIn5 - 0.06)", },
	},
},
PathDotMask = EllipseMask {
	Inputs = {
		UseFrameFormatSettings = Input { Value = 1, },
		Center = Input { Expression = "Point(0.5 + HUDData3.NumberIn3 * 0.14, 0.5 + HUDData3.NumberIn4 * 0.14 * {{aspect}})", },
		Width = Input { Value = 0.012, },
		Height = Input { Value = 0.012, },
		EffectMask = Input { SourceOp = "PathTrail", Source = "Mask", },
	},
},
PathBright = Background {
	Inputs = {
