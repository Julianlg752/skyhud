PathMerge = Merge {
	Inputs = {
		Background = Input { SourceOp = "PathBox", Source = "Output", },
		Foreground = Input { SourceOp = "PathFaint", Source = "Output", },
		PerformDepthMerge = Input { Value = 0, },
	},
},
PathOut = Merge {
	Inputs = {
		Background = Input { SourceOp = "PathMerge", Source = "Output", },
		Foreground = Input { SourceOp = "PathBright", Source = "Output", },
		PerformDepthMerge = Input { Value = 0, },
	},
},
