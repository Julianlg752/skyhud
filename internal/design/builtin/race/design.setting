		TopLeftGreen = Input { Expression = "{{accent.g}} * (0.55 * math.min(1, HUDData.NumberIn1 / 70) * HUDData.NumberIn2)", },
		TopLeftBlue = Input { Expression = "{{accent.b}} * (0.55 * math.min(1, HUDData.NumberIn1 / 70) * HUDData.NumberIn2)", },
		TopLeftAlpha = Input { Expression = "0.55 * math.min(1, HUDData.NumberIn1 / 70) * HUDData.NumberIn2", },
		EffectMask = Input { SourceOp = "FXGlowMask", Source = "Mask", },
	},
},
