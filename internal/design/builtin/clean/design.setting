SticksDotR = EllipseMask {
	Inputs = {
		UseFrameFormatSettings = Input { Value = 1, },
		Center = Input { Expression = "Point(0.54 + HUDData2.NumberIn4 * 0.0225, 0.5 + HUDData2.NumberIn3 * 0.0225 * {{aspect}})", },
		Width = Input { Value = 0.01, },
		Height = Input { Value = 0.01, },
		EffectMask = Input { SourceOp = "SticksDotL", Source = "Mask", },
	},
},
SticksShade = Background {
	Inputs = {
		UseFrameFormatSettings = Input { Value = 1, },
		TopLeftRed = Input { Expression = "0 * (0.5 * HUDData2.NumberIn5)", },
		TopLeftGreen = Input { Expression = "0 * (0.5 * HUDData2.NumberIn5)", },
		TopLeftBlue = Input { Expression = "0 * (0.5 * HUDData2.NumberIn5)", },
		TopLeftAlpha = Input { Expression = "0.5 * HUDData2.NumberIn5", },
		EffectMask = Input { SourceOp = "SticksPadR", Source = "Mask", },
	},
},
SticksFrame = Background {
	Inputs = {
		UseFrameFormatSettings = Input { Value = 1, },
		TopLeftRed = Input { Expression = "{{main.r}} * (HUDData2.NumberIn5)", },
		TopLeftGreen = Input { Expression = "{{main.g}} * (HUDData2.NumberIn5)", },
		TopLeftBlue = Input { Expression = "{{main.b}} * (HUDData2.NumberIn5)", },
		TopLeftAlpha = Input { Expression = "HUDData2.NumberIn5", },
		EffectMask = Input { SourceOp = "SticksFrameR", Source = "Mask", },
	},
},
SticksDots = Background {
	Inputs = {
		UseFrameFormatSettings = Input { Value = 1, },
		TopLeftRed = Input { Expression = "{{main.r}} * (HUDData2.NumberIn5)", },
		TopLeftGreen = Input { Expression = "{{main.g}} * (HUDData2.NumberIn5)", },
		TopLeftBlue = Input { Expression = "{{main.b}} * (HUDData2.NumberIn5)", },
		TopLeftAlpha = Input { Expression = "HUDData2.NumberIn5", },
		EffectMask = Input { SourceOp = "SticksDotR", Source = "Mask", },
	},
},
SticksOut0 = Merge {
	Inputs = {
		Background = Input { SourceOp = "SticksShade", Source = "Output", },
		Foreground = Input { SourceOp = "SticksFrame", Source = "Output", },
		PerformDepthMerge = Input { Value = 0, },
	},
},
SticksOut = Merge {
	Inputs = {
		Background = Input { SourceOp = "SticksOut0", Source = "Output", },
		Foreground = Input { SourceOp = "SticksDots", Source = "Output", },
		PerformDepthMerge = Input { Value = 0, },
	},
},
FlipPillMask = RectangleMask {
	Inputs = {
		UseFrameFormatSettings = Input { Value = 1, },
		Center = Input { Value = { 0.5, 0.5 }, },
		Width = Input { Value = 0.08, },
		Height = Input { Expression = "0.035 * {{aspect}}", },
		CornerRadius = Input { Value = 0.5, },
	},
},
FlipPill = Background {
	Inputs = {
		UseFrameFormatSettings = Input { Value = 1, },
		TopLeftRed = Input { Expression = "{{main.r}} * (HUDData3.NumberIn7)", },
		TopLeftGreen = Input { Expression = "{{main.g}} * (HUDData3.NumberIn7)", },
		TopLeftBlue = Input { Expression = "{{main.b}} * (HUDData3.NumberIn7)", },
		TopLeftAlpha = Input { Expression = "HUDData3.NumberIn7", },
		EffectMask = Input { SourceOp = "FlipPillMask", Source = "Mask", },
	},
},
FlipText = TextPlus {
	Inputs = {
		UseFrameFormatSettings = Input { Value = 1, },
		Wrap = Input { Value = 1, },
		LayoutRotation = Input { Value = 1, },
		TransformRotation = Input { Value = 1, },
		Center = Input { Value = { 0.5, 0.5 }, },
		Size = Input { Value = 0.03, },
		Font = Input { Value = "{{font}}", },
		Style = Input { Value = "Regular", },
		Red1 = Input { Value = 0.07, },
		Green1 = Input { Value = 0.07, },
		Blue1 = Input { Value = 0.07, },
		StyledText = Input { Expression = "Text(HUDData3.NumberIn7 > 0.5 and \"Flip\" or \"\")", },
		VerticalJustificationNew = Input { Value = 3, },
		HorizontalJustificationNew = Input { Value = 3, },
	},
},
FlipOut = Merge {
	Inputs = {
		Background = Input { SourceOp = "FlipPill", Source = "Output", },
		Foreground = Input { SourceOp = "FlipText", Source = "Output", },
		PerformDepthMerge = Input { Value = 0, },
	},
},
